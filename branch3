<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rear Hub Analysis Tool - Mode Matrix Engine</title>
  <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://unpkg.com/recharts@2.12.7/umd/Recharts.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-[#060d18] text-[#e2e8f0]">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useMemo } = React;
    const { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, Cell } = Recharts;

    const WHEEL_SIZES = {
      '29"':   { erd: 600, label: '29" ISO 622' },
      '27.5"': { erd: 559, label: '27.5" ISO 584' },
      '26"':   { erd: 534, label: '26" ISO 559' },
    };

    const kgf_to_N = 9.80665;

    // --- Linear Algebra Core ---
    function zeros(r, c) { return Array.from({ length: r }, () => Array(c).fill(0)); }
    function transpose(A) { return A[0].map((_, j) => A.map(row => row[j])); }
    function matMul(A, B) {
      const r = A.length, n = B.length, c = B[0].length;
      const out = zeros(r, c);
      for (let i = 0; i < r; i++) {
        for (let k = 0; k < n; k++) {
          if (A[i][k] === 0) continue;
          for (let j = 0; j < c; j++) out[i][j] += A[i][k] * B[k][j];
        }
      }
      return out;
    }
    function matVecMul(A, x) { return A.map(row => row.reduce((s, v, i) => s + v * x[i], 0)); }
    function addInPlace(A, B, scale = 1) {
      for (let i = 0; i < A.length; i++) {
        for (let j = 0; j < A[0].length; j++) A[i][j] += scale * B[i][j];
      }
    }
    function addMatrices(A, B) {
      return A.map((row, i) => row.map((v, j) => v + B[i][j]));
    }
    
    // Stable Gaussian Elimination with Partial Pivoting
    function solveLinear(A, b) {
      const n = A.length;
      const M = A.map((row, i) => [...row, b[i]]);
      for (let k = 0; k < n; k++) {
        let piv = k;
        for (let i = k + 1; i < n; i++) if (Math.abs(M[i][k]) > Math.abs(M[piv][k])) piv = i;
        [M[k], M[piv]] = [M[piv], M[k]];
        const div = M[k][k];
        if (Math.abs(div) < 1e-14) continue; // Prevent NaN on near-singular modes
        for (let j = k; j <= n; j++) M[k][j] /= div;
        for (let i = 0; i < n; i++) {
          if (i === k) continue;
          const f = M[i][k];
          for (let j = k; j <= n; j++) M[i][j] -= f * M[k][j];
        }
      }
      return M.map(row => row[n]);
    }

    // Outer product / Vector helpers
    function unit3() { return [[1,0,0],[0,1,0],[0,0,1]]; }
    function outer3(a, b) { return a.map(ai => b.map(bj => ai * bj)); }
    function subOuter(A, B) { return A.map((row,i) => row.map((v,j) => v - B[i][j])); }
    function scaleMat(A, s) { return A.map(row => row.map(v => v * s)); }
    function scaleOuter(a, b, s) { return outer3(a, b).map(row => row.map(v => v * s)); }
    function addOuter(A, B) { return A.map((row,i) => row.map((v,j) => v + B[i][j])); }
    function dot(a, b) { return a.reduce((s, v, i) => s + v * b[i], 0); }
    function crossVec(a, b) { return [a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]]; }
    function crossMatVec(a, b) { return crossVec(a, b); } // Simplify for 3x1

    // --- Physical Classes ---
    class Rim {
      constructor(radius, area, I_rad, I_lat, J_tor, I_warp, young_mod, shear_mod, sec_params={}) {
        this.radius = radius;
        this.area = area;
        this.I_rad = I_rad;
        this.I_lat = I_lat;
        this.J_tor = J_tor;
        this.I_warp = I_warp;
        this.young_mod = young_mod;
        this.shear_mod = shear_mod;
        this.sec_params = sec_params;
      }
    }

    class Hub {
      constructor(diameter_nds, diameter_ds, width_nds, width_ds) {
        this.diameter_nds = diameter_nds;
        this.diameter_ds = diameter_ds;
        this.width_nds = width_nds;
        this.width_ds = width_ds;
      }
    }

    class Spoke {
      constructor(rim_pt, hub_pt, diameter, young_mod) {
        this.EA = (Math.PI / 4) * (diameter ** 2) * young_mod;
        this.diameter = diameter;
        this.young_mod = young_mod;
        this.tension = 0;
        this.rim_pt = rim_pt;
        this.hub_pt = hub_pt;

        const du = hub_pt[2] - rim_pt[2]; // Lateral (x)
        const dv = (rim_pt[0] - hub_pt[0]) + hub_pt[0] * (1 - Math.cos(hub_pt[1] - rim_pt[1])); // Radial (y)
        const dw = hub_pt[0] * Math.sin(hub_pt[1] - rim_pt[1]); // Tangential (z)

        this.length = Math.sqrt(du ** 2 + dv ** 2 + dw ** 2);
        this.n = [du / this.length, dv / this.length, dw / this.length];
        this.b = [rim_pt[2], 0, 0];
      }

      calc_k(tension=true) {
        const n = this.n;
        const e3 = [0, 0, 1];
        const K_e = this.EA / this.length;
        const K_t = tension ? this.tension / this.length : 0;
        
        // Exact 3x3 spoke stiffness matrix
        const k_f = addOuter(scaleOuter(n, n, K_e), scaleMat(subOuter(unit3(), outer3(n, n)), K_t));
        const dFdphi = matVecMul(k_f, crossMatVec(e3, this.b));
        const dTdphi = dot(crossVec(this.b, e3), matVecMul(k_f, crossVec(this.b, e3)));
        
        const k = zeros(4, 4);
        for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) k[i][j] = k_f[i][j];
        for (let i = 0; i < 3; i++) {
          k[i][3] = dFdphi[i];
          k[3][i] = dFdphi[i];
        }
        k[3][3] = dTdphi;
        return k;
      }

      calc_tension_change(d, a=0) {
        if (d.length < 4) d = d.concat([0]);
        const e3 = [0, 0, 1];
        const un = [d[0], d[1], d[2]].map((v, i) => v + d[3] * crossVec(e3, this.b)[i]);
        return (this.EA / this.length) * (a - dot(this.n, un));
      }
    }

    class BicycleWheel {
      constructor() {
        this.spokes = [];
        this.rim = null;
        this.hub = null;
      }

      lace_cross(n_spokes, n_cross, diameter, young_mod, offset=0) {
        this.spokes = [];
        const n_half = n_spokes / 2;
        
        // Drive Side
        for (let s = 0; s < n_half; s++) {
          const theta_rim = (2 * Math.PI / n_spokes) * (s * 2 + 1); // Interleaved
          const s_dir = 2 * ((s + 1) % 2) - 1;
          const rim_pt = [this.rim.radius, theta_rim, -offset]; // FIXED JS TUPLE BUG
          const hub_pt = [this.hub.diameter_ds / 2, theta_rim + 2 * Math.PI / n_half * n_cross * s_dir, -this.hub.width_ds];
          this.spokes.push(new Spoke(rim_pt, hub_pt, diameter, young_mod));
        }

        // Non-Drive Side
        for (let s = 0; s < n_half; s++) {
          const theta_rim = (2 * Math.PI / n_spokes) * (s * 2);
          const s_dir = 2 * ((s + 1) % 2) - 1;
          const rim_pt = [this.rim.radius, theta_rim, offset]; // FIXED JS TUPLE BUG
          const hub_pt = [this.hub.diameter_nds / 2, theta_rim + 2 * Math.PI / n_half * n_cross * s_dir, this.hub.width_nds];
          this.spokes.push(new Spoke(rim_pt, hub_pt, diameter, young_mod));
        }
      }

      apply_tension(T_right) {
        // T_right is Drive Side tension
        const s_ds = this.spokes[0];
        const s_nds = this.spokes[this.spokes.length / 2];
        const T_l = Math.abs(s_ds.n[0] / s_nds.n[0]) * T_right; // NDS tension calculated by bracing angle ratio
        
        for (let i = 0; i < this.spokes.length / 2; i++) this.spokes[i].tension = T_right;
        for (let i = this.spokes.length / 2; i < this.spokes.length; i++) this.spokes[i].tension = T_l;
      }
    }

    class ModeMatrix {
      constructor(wheel, N=24) {
        this.wheel = wheel;
        this.n_modes = N;
      }

      B_theta(theta, comps=[0,1,2,3]) {
        const thetaArr = Array.isArray(theta) ? theta : [theta];
        const B = zeros(thetaArr.length * comps.length, 4 + 8 * this.n_modes);
        for (let it = 0; it < thetaArr.length; it++) {
          for (let ic = 0; ic < comps.length; ic++) B[comps.length * it + ic][comps[ic]] = 1;
          for (let n = 1; n <= this.n_modes; n++) {
            const c = Math.cos(n * thetaArr[it]);
            const s = Math.sin(n * thetaArr[it]);
            for (let ic = 0; ic < comps.length; ic++) {
              const idx = comps[ic];
              B[comps.length * it + ic][4 + 8 * (n - 1) + 2 * idx] = c;
              B[comps.length * it + ic][4 + 8 * (n - 1) + 2 * idx + 1] = s;
            }
          }
        }
        return B;
      }

      K_rim_matl() {
        const R = this.wheel.rim.radius;
        const EA = this.wheel.rim.young_mod * this.wheel.rim.area;
        const EI_rad = this.wheel.rim.young_mod * this.wheel.rim.I_rad;
        const EI_lat = this.wheel.rim.young_mod * this.wheel.rim.I_lat;
        const EIw = this.wheel.rim.young_mod * this.wheel.rim.I_warp;
        const GJ = this.wheel.rim.shear_mod * this.wheel.rim.J_tor;
        const y0 = this.wheel.rim.sec_params.y_0 || 0;
        
        const K = zeros(4 + 8 * this.n_modes, 4 + 8 * this.n_modes);
        K[1][1] = 2 * Math.PI * EA / R;
        K[3][3] = 2 * Math.PI * EI_lat / R;

        for (let n = 1; n <= this.n_modes; n++) {
          const i0 = 4 + (n - 1) * 8;
          // Radial
          K[i0 + 2][i0 + 2] = EI_rad * Math.PI / R**3 * n**4 + EA * Math.PI / R * (1 + y0 / R * n**2)**2;
          K[i0 + 3][i0 + 3] = K[i0 + 2][i0 + 2];
          K[i0 + 4][i0 + 4] = EI_rad * Math.PI / R**3 * n**2 + EA * Math.PI / R * n**2 * (1 + y0 / R)**2;
          K[i0 + 5][i0 + 5] = K[i0 + 4][i0 + 4];
          const kvw = -EI_rad * Math.PI / R**3 * n**3 - EA * Math.PI * n / R * (1 + y0 / R * (1 + n**2) + (y0**2 / R**2) * n**2);
          K[i0 + 2][i0 + 5] = kvw; K[i0 + 5][i0 + 2] = kvw;
          K[i0 + 3][i0 + 4] = -kvw; K[i0 + 4][i0 + 3] = -kvw;
          
          // Lateral & Twist
          K[i0 + 0][i0 + 0] = EI_lat * Math.PI / R**3 * n**4 + EIw * Math.PI / R**5 * n**4 + GJ * Math.PI / R**3 * n**2;
          K[i0 + 1][i0 + 1] = K[i0 + 0][i0 + 0];
          K[i0 + 0][i0 + 6] = -(EI_lat * Math.PI / R**2 * n**2 + EIw * Math.PI / R**4 * n**4 + GJ * Math.PI / R**2 * n**2);
          K[i0 + 6][i0 + 0] = K[i0 + 0][i0 + 6];
          K[i0 + 1][i0 + 7] = K[i0 + 0][i0 + 6]; K[i0 + 7][i0 + 1] = K[i0 + 0][i0 + 6];
          K[i0 + 6][i0 + 6] = EI_lat * Math.PI / R + EIw * Math.PI / R**3 * n**4 + GJ * Math.PI / R * n**2;
          K[i0 + 7][i0 + 7] = K[i0 + 6][i0 + 6];
        }
        return K;
      }

      K_spk(tension=true) {
        const dim = 4 + 8 * this.n_modes;
        const K = zeros(dim, dim);
        for (const s of this.wheel.spokes) {
          const B = this.B_theta(s.rim_pt[1]);
          const contrib = matMul(transpose(B), matMul(s.calc_k(tension), B));
          addInPlace(K, contrib, 1);
        }
        return K;
      }

      F_ext(theta, f) {
        return matVecMul(transpose(this.B_theta(theta)), f);
      }

      rim_def_lat(theta, dm) { return matVecMul(this.B_theta(theta, 0), dm); }
      rim_def_rad(theta, dm) { return matVecMul(this.B_theta(theta, 1), dm); }
    }

    // --- High Level Assembly ---
    function buildWheel({ preset, wheelKey, offsetRim, tDS, nSpokes }) {
      const rimOffsetMm = offsetRim ? 3.0 : 0.0;
      const erd = WHEEL_SIZES[wheelKey].erd;
      
      // Standard MTB Rim Profile (Stans Flow-esque)
      const rim = new Rim(erd / 2 / 1000, 0.00045, 1.2e-8, 0.4e-8, 2.0e-10, 0.5e-10, 69e9, 26e9);
      const hub = new Hub(preset.hub_diameter_nds, preset.hub_diameter_ds, preset.d_nds / 1000, preset.d_ds / 1000);
      
      const wheel = new BicycleWheel();
      wheel.rim = rim;
      wheel.hub = hub;
      
      const spokeDia = 1.8e-3; // 1.8mm butted
      const spokeE = 200e9; // Steel
      wheel.lace_cross(nSpokes, 3, spokeDia, spokeE, rimOffsetMm / 1000);
      wheel.apply_tension(tDS * kgf_to_N); // Apply tension in Newtons
      return wheel;
    }

    function calcWheel(wheel, nUpper=24) {
      const mm = new ModeMatrix(wheel, nUpper);
      
      // Assemble Global Stiffness Matrix
      const K_r = mm.K_rim_matl();
      const K_s = mm.K_spk(true);
      const K_global = addMatrices(K_r, K_s);

      // Solve 100N Load vectors
      const dLat = solveLinear(K_global, mm.F_ext(0, [100, 0, 0, 0])); 
      const dRad = solveLinear(K_global, mm.F_ext(0, [0, 100, 0, 0]));

      // Extract nodal deflections at theta=0
      const latDef = mm.rim_def_lat(0, dLat)[0];
      const radDef = mm.rim_def_rad(0, dRad)[0];
      
      // Stiffness = Force / Displacement
      const K_lat = 100 / Math.max(Math.abs(latDef), 1e-12);
      const K_rad = 100 / Math.max(Math.abs(radDef), 1e-12);

      // Extract spoke tension changes
      const latT = wheel.spokes.map(s => s.calc_tension_change(matVecMul(mm.B_theta(s.rim_pt[1]), dLat)));
      const radT = wheel.spokes.map(s => s.calc_tension_change(matVecMul(mm.B_theta(s.rim_pt[1]), dRad)));

      // Detensioning threshold: Load to slacken the weakest spoke (T_initial / Delta_T_per_100N)
      // Multiply by 100 because the solved deformation is based on a 100N load
      const F_lat = 100 * Math.min(...wheel.spokes.map((s, i) => s.tension / Math.max(Math.abs(latT[i]), 1e-12)));
      const F_rad = 100 * Math.min(...wheel.spokes.map((s, i) => s.tension / Math.max(Math.abs(radT[i]), 1e-12)));

      const s_ds = wheel.spokes[0];
      const s_nds = wheel.spokes[wheel.spokes.length / 2];

      return {
        K_lat: +(K_lat / 1000).toFixed(1), // N/mm
        K_rad: +(K_rad / 1000).toFixed(0),
        F_lat_kgf: +(F_lat / kgf_to_N).toFixed(1), // Load in kgf to slack
        F_rad_kgf: +(F_rad / kgf_to_N).toFixed(1),
        ratio_pct: +(s_nds.tension / s_ds.tension * 100).toFixed(1),
        symmetry_pct: +(Math.min(s_ds.tension, s_nds.tension) / Math.max(s_ds.tension, s_nds.tension) * 100).toFixed(1),
        t_nds: +(s_nds.tension / kgf_to_N).toFixed(1),
        beta_ds: +(Math.asin(Math.abs(s_ds.n[0])) * 180 / Math.PI).toFixed(2),
        beta_nds: +(Math.asin(Math.abs(s_nds.n[0])) * 180 / Math.PI).toFixed(2),
        L_ds_mm: +(s_ds.length * 1000).toFixed(1),
        L_nds_mm: +(s_nds.length * 1000).toFixed(1),
      };
    }

    const PRESETS = [
      { id:'r142', short:'142mm', name:'ISO 142×12 Rear', old:142, d_ds:20.1, d_nds:33.9, hub_diameter_ds:57.4e-3, hub_diameter_nds:57.4e-3 },
      { id:'r148', short:'Boost', name:'Boost 148×12 Rear', old:148, d_ds:24.0, d_nds:36.3, hub_diameter_ds:57.4e-3, hub_diameter_nds:57.4e-3 },
      { id:'r157', short:'Superboost', name:'Superboost 157×12', old:157, d_ds:28.8, d_nds:42.3, hub_diameter_ds:57.4e-3, hub_diameter_nds:57.4e-3 },
      { id:'r157b', short:'Spank 150', name:'Spank 150/157 Rear', old:157, d_ds:29.5, d_nds:39.6, hub_diameter_ds:58.0e-3, hub_diameter_nds:58.0e-3 },
    ];

    function symCol(sym) {
      if (sym >= 90) return '#22c55e';
      if (sym >= 80) return '#84cc16';
      if (sym >= 70) return '#eab308';
      return '#ef4444';
    }

    function ChartTip({active, payload, label}) {
      if (!active || !payload?.length) return null;
      return (
        <div className="bg-[#0b1826] border border-[#1e3050] p-2 font-mono text-[11px]">
          <p className="text-[#5a80a0] mb-1 text-[10px]">{label}</p>
          {payload.map((p,i) => <p key={i} style={{color:p.fill||'#94a3b8'}}>{p.name}: {p.value}</p>)}
        </div>
      );
    }

    function MetricCard({ label, value, unit, color, sub }) {
      return (
        <div className="bg-[#0a1620] border rounded p-3 text-center" style={{borderColor: `${color}33`}}>
          <div className="font-mono text-[9px] text-[#2d4a6a] tracking-widest mb-1">{label}</div>
          <div className="font-mono text-2xl font-light leading-none" style={{color}}>{value}</div>
          <div className="font-mono text-[10px] text-[#2d4a6a] mt-1">{unit}</div>
          {sub && <div className="font-mono text-[9px] mt-2 opacity-70" style={{color}}>{sub}</div>}
        </div>
      );
    }

    function HubAnalysis() {
      const [wheelKey, setWheelKey] = useState('29"');
      const [presetId, setPresetId] = useState('r148');
      const [tDS, setTDS] = useState(115);
      const [nSpokes, setNSpokes] = useState(32);
      const [offsetRim, setOffsetRim] = useState(false);
      const [nUpper, setNUpper] = useState(16); // Lowered slightly for JS performance head-room

      const rimOffsetMm = offsetRim ? 3.0 : 0.0;
      
      const data = useMemo(() => PRESETS.map(p => {
        const w = buildWheel({ preset: p, wheelKey, offsetRim, tDS, nSpokes });
        const res = calcWheel(w, nUpper);
        return { ...p, d_ds_display: p.d_ds + rimOffsetMm, d_nds_display: p.d_nds - rimOffsetMm, ...res, isActive: p.id === presetId };
      }), [wheelKey, offsetRim, tDS, nSpokes, nUpper, presetId, rimOffsetMm]);

      const activeData = data.find(d => d.id === presetId);

      return (
        <div className="bg-[#060d18] min-h-screen font-mono text-[#e2e8f0] text-xs">
          <div className="bg-gradient-to-b from-[#0b1e36] to-[#060d18] border-b border-[#1e3050] p-6">
            <div className="text-[10px] text-blue-500 tracking-[0.25em] mb-1 uppercase">Hub Engineering Analysis</div>
            <h1 className="text-xl font-light tracking-wide text-slate-100">WHEEL STRENGTH: DISCRETE MODE MATRIX</h1>
            <p className="text-[11px] text-[#4a6a8a] mt-1">Exact matrix formulation via bike-wheel-calc theory.</p>
          </div>

          <div className="bg-[#080f1a] border-b border-[#1e3050] p-6">
            <div className="grid grid-cols-2 md:grid-cols-4 gap-6">
              
              <div>
                <label className="block text-[9px] text-[#2d4a6a] tracking-widest mb-2">HUB STANDARD</label>
                <select value={presetId} onChange={e=>setPresetId(e.target.value)} className="w-full bg-[#0a1620] text-blue-400 p-2 border border-[#1e3050] cursor-pointer">
                  {PRESETS.map(p => <option key={p.id} value={p.id}>{p.name}</option>)}
                </select>
              </div>

              <div>
                <label className="block text-[9px] text-[#2d4a6a] tracking-widest mb-2">DS TENSION ({tDS} kgf)</label>
                <input type="range" min={80} max={140} value={tDS} onChange={e=>setTDS(+e.target.value)} className="w-full accent-amber-500" />
              </div>

              <div>
                <label className="block text-[9px] text-[#2d4a6a] tracking-widest mb-2">WHEEL SIZE</label>
                <div className="flex gap-2">
                  {Object.entries(WHEEL_SIZES).map(([k]) => (
                    <button key={k} onClick={()=>setWheelKey(k)} className={`px-3 py-1 border rounded ${wheelKey===k ? 'bg-blue-900 border-blue-500 text-blue-300' : 'bg-[#0a1620] border-[#1e3050] text-[#4a6a8a]'}`}>{k}</button>
                  ))}
                </div>
              </div>

              <div>
                <label className="block text-[9px] text-[#2d4a6a] tracking-widest mb-2">3MM ASYMMETRIC RIM</label>
                <button onClick={() => setOffsetRim(!offsetRim)} className={`w-full px-3 py-1 border rounded ${offsetRim ? 'bg-green-900 border-green-500 text-green-300' : 'bg-[#0a1620] border-[#1e3050] text-[#4a6a8a]'}`}>
                  {offsetRim ? '✓ ENABLED' : 'DISABLED'}
                </button>
              </div>

            </div>
          </div>

          <div className="max-w-7xl mx-auto p-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div className="lg:col-span-1 space-y-6">
              <div className="bg-[#0b1826] border border-[#1e3050] rounded p-5">
                 <div className="text-[10px] text-blue-500 tracking-widest mb-4 uppercase">System Data</div>
                 <MetricCard label="TENSION SYMMETRY" value={`${activeData.symmetry_pct}`} unit="%" color={symCol(activeData.symmetry_pct)} />
                 <div className="grid grid-cols-2 gap-3 mt-3">
                   <MetricCard label="NDS TENSION" value={activeData.t_nds} unit="kgf" color="#a78bfa" />
                   <MetricCard label="FLANGE SPAN" value={(activeData.d_ds + activeData.d_nds).toFixed(1)} unit="mm" color="#38bdf8" />
                 </div>
                 <div className="grid grid-cols-2 gap-3 mt-3">
                   <MetricCard label="β DS" value={activeData.beta_ds} unit="deg" color="#f59e0b" />
                   <MetricCard label="β NDS" value={activeData.beta_nds} unit="deg" color="#60a5fa" />
                 </div>
              </div>
            </div>

            <div className="lg:col-span-2 space-y-6">
               <div className="bg-[#0b1826] border border-[#1e3050] rounded p-5">
                  <div className="text-[10px] text-green-500 tracking-widest mb-4 uppercase">Matrix Solver Results</div>
                  <div className="grid grid-cols-2 gap-4">
                    <MetricCard label="LATERAL DETENSION LOAD" value={activeData.F_lat_kgf} unit="kgf" color="#f59e0b" sub="Force required to completely slacken lateral spoke" />
                    <MetricCard label="RADIAL DETENSION LOAD" value={activeData.F_rad_kgf} unit="kgf" color="#a78bfa" sub="Force required to completely slacken radial spoke" />
                    <MetricCard label="LATERAL STIFFNESS" value={activeData.K_lat} unit="N/mm" color="#38bdf8" sub={`Coupled matrix inverse (N=${nUpper})`} />
                    <MetricCard label="RADIAL STIFFNESS" value={activeData.K_rad} unit="N/mm" color="#4ade80" sub={`Coupled matrix inverse (N=${nUpper})`} />
                  </div>
               </div>

               <div className="bg-[#0b1826] border border-[#1e3050] rounded p-5">
                  <div className="text-[10px] text-amber-500 tracking-widest mb-4 uppercase">Lateral Strength Limit (kgf)</div>
                  <ResponsiveContainer width="100%" height={220}>
                    <BarChart data={data} margin={{top:10,right:10,bottom:40,left:0}}>
                      <CartesianGrid strokeDasharray="3,3" stroke="#0d1e33"/>
                      <XAxis dataKey="short" tick={{fill:'#4a6a8a',fontSize:10}} angle={-15} textAnchor="end"/>
                      <YAxis tick={{fill:'#4a6a8a',fontSize:10}} domain={['dataMin - 10', 'auto']} />
                      <Tooltip content={<ChartTip/>}/>
                      <Bar dataKey="F_lat_kgf">{data.map((d,i)=><Cell key={i} fill={d.isActive ? '#f59e0b' : '#3d5a80'}/>)}</Bar>
                    </BarChart>
                  </ResponsiveContainer>
               </div>
            </div>
          </div>
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<HubAnalysis />);
  </script>
</body>
</html>
