<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rear Hub Analysis Tool</title>
  <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://unpkg.com/prop-types@15.8.1/prop-types.min.js"></script>
  <script src="https://unpkg.com/recharts@2.12.7/umd/Recharts.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-[#060d18] text-[#e2e8f0]">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useMemo } = React;
    const { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, Cell } = Recharts;

    const WHEEL_SIZES = {
      '29"':   { erd: 600, label: '29" ISO 622' },
      '27.5"': { erd: 559, label: '27.5" ISO 584' },
      '26"':   { erd: 534, label: '26" ISO 559' },
    };

    const kgf_to_N = 9.80665;

    function zeros(r, c) {
      return Array.from({ length: r }, () => Array(c).fill(0));
    }

    function transpose(A) {
      return A[0].map((_, j) => A.map(row => row[j]));
    }

    function matMul(A, B) {
      const r = A.length, n = B.length, c = B[0].length;
      const out = zeros(r, c);
      for (let i = 0; i < r; i++) {
        for (let k = 0; k < n; k++) {
          const aik = A[i][k];
          if (!aik) continue;
          for (let j = 0; j < c; j++) out[i][j] += aik * B[k][j];
        }
      }
      return out;
    }

    function matVecMul(A, x) {
      return A.map(row => row.reduce((s, v, i) => s + v * x[i], 0));
    }

    function addInPlace(A, B, scale = 1) {
      for (let i = 0; i < A.length; i++) {
        for (let j = 0; j < A[0].length; j++) A[i][j] += scale * B[i][j];
      }
    }

    function subMatrix(A, ix) {
      return ix.map(i => ix.map(j => A[i][j]));
    }

    function sortUnique(arr) {
      return [...new Set(arr)].sort((a, b) => a - b);
    }

    function rangeStep(start, stop, step) {
      const out = [];
      for (let i = start; i < stop; i += step) out.push(i);
      return out;
    }

    function solveLinear(A, b) {
      const n = A.length;
      const M = A.map((row, i) => row.slice().concat([b[i]]));
      for (let k = 0; k < n; k++) {
        let piv = k;
        for (let i = k + 1; i < n; i++) if (Math.abs(M[i][k]) > Math.abs(M[piv][k])) piv = i;
        [M[k], M[piv]] = [M[piv], M[k]];
        const div = M[k][k] || 1e-18;
        for (let j = k; j <= n; j++) M[k][j] /= div;
        for (let i = 0; i < n; i++) {
          if (i === k) continue;
          const f = M[i][k];
          for (let j = k; j <= n; j++) M[i][j] -= f * M[k][j];
        }
      }
      return M.map(row => row[n]);
    }

    class Rim {
      constructor(radius, area, I_rad, I_lat, J_tor, I_warp, young_mod, shear_mod, density=null, sec_type='general', sec_params={}) {
        this.radius = radius;
        this.area = area;
        this.I_rad = I_rad;
        this.I_lat = I_lat;
        this.J_tor = J_tor;
        this.I_warp = I_warp;
        this.young_mod = young_mod;
        this.shear_mod = shear_mod;
        this.density = density;
        this.sec_type = sec_type;
        this.sec_params = sec_params;
      }
      calc_mass() { return this.density != null ? this.density * 2 * Math.PI * this.radius * this.area : null; }
      calc_rot_inertia() { return this.density != null ? this.calc_mass() * this.radius ** 2 : null; }
    }

    class Hub {
      constructor(diameter=null, diameter_nds=null, diameter_ds=null, width=null, width_nds=null, width_ds=null, offset=null) {
        this.diameter_nds = diameter;
        this.diameter_ds = diameter;
        if (typeof diameter_nds === 'number') this.diameter_nds = diameter_nds;
        if (typeof diameter_ds === 'number') this.diameter_ds = diameter_ds;

        if (typeof width === 'number') {
          if (offset == null) offset = 0;
          this.width_nds = width / 2 + offset;
          this.width_ds = width / 2 - offset;
          if (width_nds != null || width_ds != null) throw new Error('Cannot specify width_left/right when using offset.');
        } else if (typeof width_nds === 'number' && typeof width_ds === 'number') {
          this.width_nds = width_nds;
          this.width_ds = width_ds;
        } else {
          throw new Error('width_left and width_right must both be defined if not using width.');
        }
      }
    }

    class Spoke {
      constructor(rim_pt, hub_pt, diameter, young_mod, density=null) {
        this.EA = Math.PI / 4 * diameter ** 2 * young_mod;
        this.diameter = diameter;
        this.young_mod = young_mod;
        this.density = density;
        this.tension = 0;
        this.rim_pt = rim_pt;
        this.hub_pt = hub_pt;

        const du = hub_pt[2] - rim_pt[2];
        const dv = (rim_pt[0] - hub_pt[0]) + hub_pt[0] * (1 - Math.cos(hub_pt[1] - rim_pt[1]));
        const dw = hub_pt[0] * Math.sin(hub_pt[1] - rim_pt[1]);

        this.length = Math.sqrt(du ** 2 + dv ** 2 + dw ** 2);
        this.n = [du / this.length, dv / this.length, dw / this.length];
        this.b = [rim_pt[2], 0, 0];
        this.alpha = Math.atan2(du, dv);
        this.beta = Math.atan2(dw, dv);
      }

      calc_k(tension=true) {
        const n = this.n;
        const e3 = [0, 0, 1];
        const K_e = this.EA / this.length;
        const K_t = tension ? this.tension / this.length : 0;
        const k_f = addOuter(scaleOuter(n, n, K_e), scaleOuter(subOuter(unit3(), outer3(n, n)), 1, K_t));
        const dFdphi = matVecMul(k_f, crossMatVec(e3, this.b));
        const dTdphi = dot(crossVec(this.b, e3), matVecMul(k_f, crossVec(this.b, e3)));
        const k = zeros(4, 4);
        for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) k[i][j] = k_f[i][j];
        for (let i = 0; i < 3; i++) {
          k[i][3] = dFdphi[i];
          k[3][i] = dFdphi[i];
        }
        k[3][3] = dTdphi;
        return k;
      }

      calc_k_geom() {
        const n = this.n;
        const e3 = [0, 0, 1];
        const k_f = scaleMat(subOuter(unit3(), outer3(n, n)), 1 / this.length);
        const dFdphi = matVecMul(k_f, crossMatVec(e3, this.b));
        const dTdphi = dot(crossVec(this.b, e3), matVecMul(k_f, crossVec(this.b, e3)));
        const k = zeros(4, 4);
        for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) k[i][j] = k_f[i][j];
        for (let i = 0; i < 3; i++) {
          k[i][3] = dFdphi[i];
          k[3][i] = dFdphi[i];
        }
        k[3][3] = dTdphi;
        return k;
      }

      calc_mass() { return this.density != null ? this.density * this.length * Math.PI / 4 * this.diameter ** 2 : null; }
      calc_rot_inertia() { return this.density != null ? this.calc_mass() * (this.length * this.n[1]) ** 2 / 12 : null; }

      calc_tension_change(d, a=0) {
        if (d.length < 4) d = d.concat([0]);
        const e3 = [0, 0, 1];
        const un = [d[0], d[1], d[2]].map((v, i) => v + d[3] * crossVec(e3, this.b)[i]);
        return this.EA / this.length * (a - dot(this.n, un));
      }
    }

    function unit3() { return [[1,0,0],[0,1,0],[0,0,1]]; }
    function outer3(a, b) { return a.map(ai => b.map(bj => ai * bj)); }
    function subOuter(A, B) { return A.map((row,i) => row.map((v,j) => v - B[i][j])); }
    function scaleMat(A, s) { return A.map(row => row.map(v => v * s)); }
    function scaleOuter(a, b, s) { return outer3(a, b).map(row => row.map(v => v * s)); }
    function addOuter(A, B) { return A.map((row,i) => row.map((v,j) => v + B[i][j])); }
    function dot(a, b) { return a.reduce((s, v, i) => s + v * b[i], 0); }
    function crossVec(a, b) {
      return [a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]];
    }
    function crossMatVec(a, b) { return crossVec(a, b); }

    class BicycleWheel {
      constructor() {
        this.spokes = [];
        this.rim = null;
        this.hub = null;
      }

      reorder_spokes() {
        const idx = this.spokes.map((s, i) => [s.rim_pt[1], i]).sort((a, b) => a[0] - b[0]).map(x => x[1]);
        this.spokes = idx.map(i => this.spokes[i]);
      }

      lace_cross(n_spokes, n_cross, diameter, young_mod, offset=0, density=null) {
        this.spokes = [];
        this.lace_cross_ds(n_spokes / 2, n_cross, diameter, young_mod, offset, density);
        this.lace_cross_nds(n_spokes / 2, n_cross, diameter, young_mod, offset, density);
        return true;
      }

      lace_cross_ds(n_spokes, n_cross, diameter, young_mod, offset=0, density=null) {
        for (let s = 0; s < n_spokes; s++) {
          const theta_rim = 2 * Math.PI / n_spokes * (s + 0.5);
          const s_dir = 2 * ((s + 1) % 2) - 1;
          const rim_pt = (this.rim.radius, theta_rim, -offset);
          const hub_pt = [this.hub.diameter_ds / 2, theta_rim + 2 * Math.PI / n_spokes * n_cross * s_dir, -this.hub.width_ds];
          this.spokes.push(new Spoke(rim_pt, hub_pt, diameter, young_mod, density));
        }
        this.reorder_spokes();
        return true;
      }

      lace_cross_nds(n_spokes, n_cross, diameter, young_mod, offset=0, density=null) {
        for (let s = 0; s < n_spokes; s++) {
          const theta_rim = 2 * Math.PI / n_spokes * s;
          const s_dir = 2 * ((s + 1) % 2) - 1;
          const rim_pt = (this.rim.radius, theta_rim, offset);
          const hub_pt = [this.hub.diameter_nds / 2, theta_rim + 2 * Math.PI / n_spokes * n_cross * s_dir, this.hub.width_nds];
          this.spokes.push(new Spoke(rim_pt, hub_pt, diameter, young_mod, density));
        }
        this.reorder_spokes();
        return true;
      }

      apply_tension(T_avg=null, T_left=null, T_right=null) {
        const s_l = this.spokes[0];
        const s_r = this.spokes[1];
        let T_l, T_r;
        if (T_avg != null) {
          const denom = Math.abs(s_l.n[0] * s_r.n[1]) + Math.abs(s_r.n[0] * s_l.n[1]);
          T_l = 2 * T_avg * Math.abs(s_r.n[0]) / denom;
          T_r = 2 * T_avg * Math.abs(s_l.n[0]) / denom;
        } else if (T_right != null) {
          T_r = T_right;
          T_l = Math.abs(s_r.n[0] / s_l.n[0]) * T_right;
        } else if (T_left != null) {
          T_l = T_left;
          T_r = Math.abs(s_l.n[0] / s_r.n[0]) * T_left;
        } else {
          throw new Error('Must specify T_avg, T_left, or T_right.');
        }
        for (let i = 0; i < this.spokes.length; i += 2) this.spokes[i].tension = T_l;
        for (let i = 1; i < this.spokes.length; i += 2) this.spokes[i].tension = T_r;
      }

      calc_kbar(tension=true) {
        let k = zeros(4, 4);
        for (const s of this.spokes) {
          const ks = s.calc_k(tension);
          for (let i = 0; i < 4; i++) for (let j = 0; j < 4; j++) k[i][j] += ks[i][j] / (2 * Math.PI * this.rim.radius);
        }
        return k;
      }

      calc_kbar_geom() {
        let k = zeros(4, 4);
        const s0 = this.spokes[0];
        const s1 = this.spokes[1];
        const Td = Math.abs(s0.n[0] * s1.n[1]) + Math.abs(s1.n[0] * s0.n[1]);
        for (const s of this.spokes) {
          const ks = s.calc_k_geom();
          const scale = Math.abs(s.n[0]) / Td / (Math.PI * this.rim.radius);
          for (let i = 0; i < 4; i++) for (let j = 0; j < 4; j++) k[i][j] += scale * ks[i][j];
        }
        return k;
      }
    }

    class ModeMatrix {
      constructor(wheel, N=24) {
        this.wheel = wheel;
        this.n_spokes = wheel.spokes.length;
        this.n_modes = N;
      }

      B_theta(theta=[0], comps=[0,1,2,3]) {
        theta = Array.isArray(theta) ? theta : [theta];
        comps = Array.isArray(comps) ? comps : [comps];
        const B = zeros(theta.length * comps.length, 4 + 8 * this.n_modes);
        for (let it = 0; it < theta.length; it++) {
          for (let ic = 0; ic < comps.length; ic++) B[comps.length * it + ic][comps[ic]] = 1;
          for (let n = 1; n <= this.n_modes; n++) {
            const c = Math.cos(n * theta[it]);
            const s = Math.sin(n * theta[it]);
            for (let ic = 0; ic < comps.length; ic++) {
              const idx = comps[ic];
              B[comps.length * it + ic][4 + 8 * (n - 1) + 2 * idx] = c;
              B[comps.length * it + ic][4 + 8 * (n - 1) + 2 * idx + 1] = s;
            }
          }
        }
        return B;
      }

      K_rim_matl(r0=true) {
        const w = this.wheel;
        const R = w.rim.radius;
        const EA = w.rim.young_mod * w.rim.area;
        const EI_rad = w.rim.young_mod * w.rim.I_rad;
        const EI_lat = w.rim.young_mod * w.rim.I_lat;
        const EIw = w.rim.young_mod * w.rim.I_warp;
        const GJ = w.rim.shear_mod * w.rim.J_tor;
        let y0 = 0;
        if (w.rim.sec_params && 'y_0' in w.rim.sec_params) y0 = w.rim.sec_params.y_0;
        const K = zeros(4 + 8 * this.n_modes, 4 + 8 * this.n_modes);
        K[1][1] = 2 * Math.PI * EA / R;
        K[3][3] = 2 * Math.PI * EI_lat / R;
        for (let n = 1; n <= this.n_modes; n++) {
          const i0 = 4 + (n - 1) * 8;
          K[i0 + 2][i0 + 2] = EI_rad * Math.PI / R**3 * n**4 + EA * Math.PI / R * (1 + y0 / R * n**2)**2;
          K[i0 + 3][i0 + 3] = K[i0 + 2][i0 + 2];
          K[i0 + 4][i0 + 4] = EI_rad * Math.PI / R**3 * n**2 + EA * Math.PI / R * n**2 * (1 + y0 / R)**2;
          K[i0 + 5][i0 + 5] = K[i0 + 4][i0 + 4];
          const kvw = -EI_rad * Math.PI / R**3 * n**3 - EA * Math.PI * n / R * (1 + y0 / R * (1 + n**2) + (y0**2 / R**2) * n**2);
          K[i0 + 2][i0 + 5] = kvw;
          K[i0 + 5][i0 + 2] = kvw;
          K[i0 + 3][i0 + 4] = -kvw;
          K[i0 + 4][i0 + 3] = -kvw;
          K[i0 + 0][i0 + 0] = EI_lat * Math.PI / R**3 * n**4 + EIw * Math.PI / R**5 * n**4 + GJ * Math.PI / R**3 * n**2;
          K[i0 + 1][i0 + 1] = K[i0 + 0][i0 + 0];
          K[i0 + 0][i0 + 6] = -(EI_lat * Math.PI / R**2 * n**2 + EIw * Math.PI / R**4 * n**4 + GJ * Math.PI / R**2 * n**2);
          K[i0 + 6][i0 + 0] = K[i0 + 0][i0 + 6];
          K[i0 + 1][i0 + 7] = K[i0 + 0][i0 + 6];
          K[i0 + 7][i0 + 1] = K[i0 + 0][i0 + 6];
          K[i0 + 6][i0 + 6] = EI_lat * Math.PI / R + EIw * Math.PI / R**3 * n**4 + GJ * Math.PI / R * n**2;
          K[i0 + 7][i0 + 7] = K[i0 + 6][i0 + 6];
        }
        return K;
      }

      K_rim_geom(r0=true) {
        const w = this.wheel;
        const R = w.rim.radius;
        let y0 = 0;
        if (w.rim.sec_params && 'y_0' in w.rim.sec_params) y0 = w.rim.sec_params.y_0;
        let r02 = 0;
        if (r0) r02 = w.rim.I_rad / w.rim.area + w.rim.I_lat / w.rim.area + y0**2;
        const K = zeros(4 + 8 * this.n_modes, 4 + 8 * this.n_modes);
        K[3][3] = -2 * Math.PI * R * y0;
        for (let n = 1; n <= this.n_modes; n++) {
          const i0 = 4 + (n - 1) * 8;
          K[i0 + 0][i0 + 0] = Math.PI * n**2 * (1 + r02 / R**2);
          K[i0 + 1][i0 + 1] = K[i0 + 0][i0 + 0];
          K[i0 + 0][i0 + 6] = Math.PI * n**2 * (y0 - r02 / R);
          K[i0 + 6][i0 + 0] = K[i0 + 0][i0 + 6];
          K[i0 + 1][i0 + 7] = K[i0 + 0][i0 + 6];
          K[i0 + 7][i0 + 1] = K[i0 + 0][i0 + 6];
          K[i0 + 6][i0 + 6] = -Math.PI * (R * y0 - r02 * n**2);
          K[i0 + 7][i0 + 7] = K[i0 + 6][i0 + 6];
        }
        const scale = w.spokes.length / (2 * Math.PI * R);
        return K.map(row => row.map(v => v * scale));
      }

      K_spk_geom(smeared_spokes=false) {
        const dim = 4 + 8 * this.n_modes;
        const K = zeros(dim, dim);
        if (smeared_spokes) {
          const k_avg = this.wheel.calc_kbar_geom();
          const scale = 2 * Math.PI * this.wheel.rim.radius;
          const M = k_avg.map(row => row.map(v => v * scale));
          for (let i = 0; i < 4; i++) for (let j = 0; j < 4; j++) K[i][j] = M[i][j];
          for (let n = 1; n <= this.n_modes; n++) {
            const a = 4 + 8 * (n - 1);
            for (let i = 0; i < 4; i++) for (let j = 0; j < 4; j++) {
              K[a + 2 * i][a + 2 * j] = M[i][j] / 2;
              K[a + 2 * i + 1][a + 2 * j + 1] = M[i][j] / 2;
            }
          }
          return K;
        }
        const s0 = this.wheel.spokes[0];
        const s1 = this.wheel.spokes[1];
        const Td = Math.abs(s0.n[0] * s1.n[1]) + Math.abs(s1.n[0] * s0.n[1]);
        for (const s of this.wheel.spokes) {
          const B = this.B_theta(s.rim_pt[1]);
          const contrib = matMul(transpose(B), matMul(s.calc_k_geom(), B));
          addInPlace(K, contrib, 2 * Math.abs(s.n[0]) / Math.max(Td, 1e-12));
        }
        return K;
      }

      K_spk(smeared_spokes=false, tension=true) {
        const dim = 4 + 8 * this.n_modes;
        const K = zeros(dim, dim);
        if (smeared_spokes) {
          const k_avg = this.wheel.calc_kbar(tension);
          const scale = 2 * Math.PI * this.wheel.rim.radius;
          const M = k_avg.map(row => row.map(v => v * scale));
          for (let i = 0; i < 4; i++) for (let j = 0; j < 4; j++) K[i][j] = M[i][j];
          for (let n = 1; n <= this.n_modes; n++) {
            const a = 4 + 8 * (n - 1);
            for (let i = 0; i < 4; i++) for (let j = 0; j < 4; j++) {
              K[a + 2 * i][a + 2 * j] = M[i][j] / 2;
              K[a + 2 * i + 1][a + 2 * j + 1] = M[i][j] / 2;
            }
          }
          return K;
        }
        for (const s of this.wheel.spokes) {
          const B = this.B_theta(s.rim_pt[1]);
          const contrib = matMul(transpose(B), matMul(s.calc_k(tension), B));
          addInPlace(K, contrib, 1);
        }
        return K;
      }

      F_ext(theta, f) {
        return matVecMul(transpose(this.B_theta(theta)), f);
      }

      get_ix_uncoupled(dim='lateral') {
        if (dim === 'lateral') {
          return sortUnique([0,3]
            .concat(rangeStep(4, 4 + 8 * this.n_modes, 8))
            .concat(rangeStep(5, 4 + 8 * this.n_modes, 8))
            .concat(rangeStep(10, 4 + 8 * this.n_modes, 8))
            .concat(rangeStep(11, 4 + 8 * this.n_modes, 8)));
        }
        return sortUnique([1,2]
          .concat(rangeStep(6, 4 + 8 * this.n_modes, 8))
          .concat(rangeStep(7, 4 + 8 * this.n_modes, 8))
          .concat(rangeStep(8, 4 + 8 * this.n_modes, 8))
          .concat(rangeStep(9, 4 + 8 * this.n_modes, 8)));
      }

      get_K_uncoupled(K, dim='lateral') {
        const ix = this.get_ix_uncoupled(dim);
        return ix.map(i => ix.map(j => K[i][j]));
      }

      rim_def_lat(theta, dm) { return matVecMul(this.B_theta(theta, 0), dm); }
      rim_def_rad(theta, dm) { return matVecMul(this.B_theta(theta, 1), dm); }
      rim_def_tan(theta, dm) { return matVecMul(this.B_theta(theta, 2), dm); }
      rim_def_rot(theta, dm) { return matVecMul(this.B_theta(theta, 3), dm); }

      spoke_tension_change(dm, a=null) {
        if (!a) a = Array(this.wheel.spokes.length).fill(0);
        return this.wheel.spokes.map((s, i) => {
          const disp = matVecMul(this.B_theta(s.rim_pt[1]), dm);
          return s.calc_tension_change(disp, a[i]);
        });
      }
    }

    function buildWheel({ preset, wheelKey, offsetRim, tDS, nSpokes }) {
      const rimOffsetMm = offsetRim ? 3.0 : 0.0;
      const erd = WHEEL_SIZES[wheelKey].erd;

      const rim = new Rim(
        erd / 2 / 1000,
        0.00045,
        4.0e-10,
        1.2e-9,
        2.0e-10,
        0.5e-10,
        69e9,
        26e9,
        null,
        'general',
        {}
      );

      const hub = new Hub(
        preset.hub_diameter || 0.057,
        preset.hub_diameter_nds || preset.hub_diameter || 0.057,
        preset.hub_diameter_ds || preset.hub_diameter || 0.057,
        preset.old / 1000,
        preset.d_nds / 1000,
        preset.d_ds / 1000,
        0
      );

      const wheel = new BicycleWheel();
      wheel.rim = rim;
      wheel.hub = hub;

      const spokeDia = 2.0e-3;
      const spokeE = 210e9;
      wheel.lace_cross(nSpokes, 3, spokeDia, spokeE, rimOffsetMm / 1000, null);
      wheel.apply_tension(tDS, null, null);
      return wheel;
    }

    function calcWheel({ wheel, nUpper=24, coupling=true, tension=true, smearedSpokes=false, r0=true }) {
      const mm = new ModeMatrix(wheel, nUpper);
      const K = addMatrices(mm.K_rim(tension, r0), mm.K_spk(smearedSpokes, tension));

      const solveMode = (F, dim) => {
        if (coupling) return solveLinear(K, F);
        const ix = mm.get_ix_uncoupled(dim);
        const Ku = mm.get_K_uncoupled(K, dim);
        const Fu = ix.map(i => F[i]);
        const du = solveLinear(Ku, Fu);
        const d = Array(K.length).fill(0);
        ix.forEach((i, k) => d[i] = du[k]);
        return d;
      };

      const dLat = solveMode(mm.F_ext(0, [1,0,0,0]), 'lateral');
      const dRad = solveMode(mm.F_ext(0, [0,1,0,0]), 'radial');

      const latDef = mm.rim_def_lat(0, dLat)[0];
      const radDef = mm.rim_def_rad(0, dRad)[0];
      const K_lat = 1 / Math.max(Math.abs(latDef), 1e-12);
      const K_rad = 1 / Math.max(Math.abs(radDef), 1e-12);

      const latT = mm.spoke_tension_change(dLat);
      const radT = mm.spoke_tension_change(dRad);

      const F_lat = Math.min(...wheel.spokes.map((s, i) => (s.tension || 0) / Math.max(Math.abs(latT[i]), 1e-12)));
      const F_rad = Math.min(...wheel.spokes.map((s, i) => (s.tension || 0) / Math.max(Math.abs(radT[i]), 1e-12)));

      const s0 = wheel.spokes[0];
      const s1 = wheel.spokes[1];
      const Tds = s0.tension || 0;
      const Tnds = s1.tension || 0;
      const ratio = Tnds / Math.max(Tds, 1e-12);
      const symmetry = Math.min(Tds, Tnds) / Math.max(Tds, Tnds);

      return {
        K_lat: +(K_lat / 1000).toFixed(1),
        K_rad: +(K_rad / 1000).toFixed(0),
        F_lat_kgf: +(F_lat / kgf_to_N).toFixed(1),
        F_rad_kgf: +(F_rad / kgf_to_N).toFixed(1),
        ratio_pct: +(ratio * 100).toFixed(1),
        symmetry_pct: +(symmetry * 100).toFixed(1),
        t_nds: +(Tnds / kgf_to_N).toFixed(1),
        beta_ds: +(Math.asin(Math.min(Math.abs(s0.n[0]), 0.999999)) * 180 / Math.PI).toFixed(2),
        beta_nds: +(Math.asin(Math.min(Math.abs(s1.n[0]), 0.999999)) * 180 / Math.PI).toFixed(2),
        L_ds_mm: +(s0.length * 1000).toFixed(1),
        L_nds_mm: +(s1.length * 1000).toFixed(1),
        ftf: +((wheel.hub.width_ds + wheel.hub.width_nds) * 1000).toFixed(1),
      };
    }

    function addMatrices(A, B) {
      return A.map((row, i) => row.map((v, j) => v + B[i][j]));
    }

