        return { width, r_hub, L, sin_beta, cos_beta, tan_beta, k_axial, tension };
      }

      const ds = sideGeom(d_ds, pcd_ds);
      const nds = sideGeom(d_nds, pcd_nds);

      const T_ds_N = t_ds * kgf_to_N;
      const T_nds_N = T_ds_N * (ds.sin_beta / Math.max(nds.sin_beta, 1e-12)) * (nds.cos_beta / Math.max(ds.cos_beta, 1e-12));

      const k_lat_ds = (T_ds_N / ds.L) + ds.k_axial * ds.sin_beta**2;
      const k_lat_nds = (T_nds_N / nds.L) + nds.k_axial * nds.sin_beta**2;
      const k_rad_ds = (T_ds_N / ds.L) + ds.k_axial * ds.cos_beta**2;
      const k_rad_nds = (T_nds_N / nds.L) + nds.k_axial * nds.cos_beta**2;

      const K_foundation_lat = ns * (k_lat_ds + k_lat_nds) / 2;
      const K_foundation_rad = ns * (k_rad_ds + k_rad_nds) / 2;

      const EI_lat = E_rim * I_lat;
      const EI_rad = E_rim * I_rad;
      const GJ = G_rim * J_tor;
      const coeff = Math.PI / Math.pow(R, 3);

      function modeContributionLat(n) {
        const q = n * n;
        return coeff * (EI_lat * Math.pow(q - 1, 2) + GJ * (q - 1));
      }

      function modeContributionRad(n) {
        const q = n * n;
        return coeff * EI_rad * Math.pow(q - 1, 2);
      }

      let compliance_lat = 1 / Math.max(2 * K_foundation_lat, 1e-12);
      let compliance_rad = 1 / Math.max(2 * K_foundation_rad, 1e-12);

      for (let n = 1; n <= nUpper; n++) {
        compliance_lat += 1 / Math.max(K_foundation_lat + modeContributionLat(n), 1e-12);
        compliance_rad += 1 / Math.max(K_foundation_rad + modeContributionRad(n), 1e-12);
      }

      const K_wheel_lat = 1 / compliance_lat;
      const K_wheel_rad = 1 / compliance_rad;

      const loadToSlack = (T, kSide, share, stiff) => {
        const deltaPerN = Math.max(share * stiff / Math.max(kSide, 1e-12), 1e-12);
        return T / deltaPerN;
      };

      const lat_share_ds = ds.k_axial * ds.sin_beta;
      const lat_share_nds = nds.k_axial * nds.sin_beta;
      const rad_share_ds = ds.k_axial * ds.cos_beta * ds.cos_beta;
      const rad_share_nds = nds.k_axial * nds.cos_beta * nds.cos_beta;

      const Flat_ds_N = loadToSlack(T_ds_N, ds.k_axial, lat_share_ds, K_wheel_lat);
      const Flat_nds_N = loadToSlack(T_nds_N, nds.k_axial, lat_share_nds, K_wheel_lat);
      const Frad_ds_N = loadToSlack(T_ds_N, ds.k_axial, rad_share_ds, K_wheel_rad);
      const Frad_nds_N = loadToSlack(T_nds_N, nds.k_axial, rad_share_nds, K_wheel_rad);

      const Flat_N = Math.min(Flat_ds_N, Flat_nds_N);
      const Frad_N = Math.min(Frad_ds_N, Frad_nds_N);

      const ratio = T_nds_N / Math.max(T_ds_N, 1e-12);
      const symmetry = Math.min(T_ds_N, T_nds_N) / Math.max(T_ds_N, T_nds_N);

      return {
        ratio_pct: +(ratio * 100).toFixed(1),
        symmetry_pct: +(symmetry * 100).toFixed(1),
        t_nds: +(T_nds_N / kgf_to_N).toFixed(1),
        beta_ds: +(Math.asin(Math.min(ds.sin_beta, 0.999999)) * 180 / Math.PI).toFixed(2),
        beta_nds: +(Math.asin(Math.min(nds.sin_beta, 0.999999)) * 180 / Math.PI).toFixed(2),
        K_lat: +(K_wheel_lat / 1000).toFixed(1),
        K_rad: +(K_wheel_rad / 1000).toFixed(0),
        F_lat_kgf: +(Flat_N / kgf_to_N).toFixed(1),
        F_rad_kgf: +(Frad_N / kgf_to_N).toFixed(1),
        L_ds_mm: +(ds.L * 1000).toFixed(1),
        L_nds_mm: +(nds.L * 1000).toFixed(1),
        ftf: +(d_ds + d_nds).toFixed(1),
      };
    }

    const PRESETS = [
